# Local default. In Vercel production, replace with a durable database URL.
TALENT_DATABASE_URL=sqlite:///./talent_sourcing.sqlite3
# Turso remote-only alternative. When TURSO_DATABASE_URL is set, it is used as the
# database URL and requires TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local review uses codex by default. In Vercel production, review resolves to openai automatically.
TALENT_CODEX_BINARY=codex
TALENT_REVIEW_WORKSPACE_ROOT=.codex-review-runs
TALENT_REVIEW_PROVIDER=auto
TALENT_REVIEW_MODEL=gpt-4.1-mini
TALENT_REVIEW_TIMEOUT_SECONDS=120
TALENT_OPENAI_API_KEY=
TALENT_OPENAI_BASE_URL=https://api.openai.com/v1

# Search provider configuration.
TALENT_SOURCING_PROVIDER=live
TALENT_EXA_API_KEY=
TALENT_BRIGHTDATA_API_KEY=
TALENT_BRIGHTDATA_ZONE=
