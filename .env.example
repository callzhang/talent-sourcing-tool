# Shared local environment values for the repository root.
# Backend also reads this file, which is useful when frontend and backend share sourcing credentials.

# Production storage alias. Prefer DATABASE_URL in Vercel production.
DATABASE_URL=
# Turso remote-only alternative. Leave DATABASE_URL empty when using these values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Production AI review alias. Prefer TALENT_OPENAI_API_KEY in Vercel production.
OPENAI_API_KEY=

# Optional explicit review override aliases.
REVIEW_PROVIDER=
REVIEW_MODEL=

# Shared sourcing provider aliases.
EXA_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
